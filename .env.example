# Copy to .env and fill in your values. Do not commit .env.
NTFY_BASE_URL=https://ntfy.sh
NTFY_TOPIC=your_topic_here
# Used only to seed titles.json on first run — after that, manage titles in the app.
NTFY_TITLES=📥 To Do,🔗 Web Link,🧺 Housework
# Address the dev server binds to. Defaults to 127.0.0.1 (loopback only).
# Set this to a LAN IP only when a firewall rule limits port 5000 to your
# reverse proxy - the app has no login of its own, so anything that can reach
# the port can read and change your reminders.
BIND_HOST=127.0.0.1
# LAN address of this reminders app, used to build the "Reschedule" action button
NTFY_REMINDERS_URL=http://your-server:5000
# Optional PNG shown as the notification icon
NTFY_ICON_URL=http://your-server:5000/static/icon.png
